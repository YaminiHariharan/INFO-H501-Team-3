    "    'Cafes': 'Casual',\n",
    "    'Coffee & Tea': 'Casual',\n",
    "    'Seafood': 'Seafood',\n",
    "    'Steakhouses': 'Steakhouse',\n",
    "    'Delis': 'Casual',\n",
    "    'Chicken Wings': 'American',\n",
    "    'Salad': 'Casual',\n",
    "}\n",
    "\n",
    "def assign_cuisine(categories_list):\n",
    "    if not isinstance(categories_list, list):\n",
